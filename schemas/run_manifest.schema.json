{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mmals/siamese-compression/run_manifest.schema.json",
  "title": "MMALS Siamese Compression Run Manifest",
  "type": "object",
  "required": [
    "contract_version",
    "schema_version",
    "run_id",
    "run_status",
    "evidence_level",
    "scientific_claim_allowed",
    "configuration_sha256",
    "implementation_sha256",
    "dataset",
    "environment",
    "threshold_policy",
    "artifacts"
  ],
  "properties": {
    "contract_version": {"const": "mmals-replay-domain-pack/1.0"},
    "schema_version": {"type": "string"},
    "run_id": {"type": "string", "minLength": 1},
    "run_status": {
      "enum": ["SMOKE_VALIDATED", "BENCHMARK_EXECUTED", "FAILED", "INCOMPLETE"]
    },
    "evidence_level": {"type": "string"},
    "scientific_claim_allowed": {"type": "boolean"},
    "configuration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "implementation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "threshold_policy": {"const": "calibrate_on_validation_then_freeze_before_test"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
